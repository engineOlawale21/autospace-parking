DATABASE_URL="postgresql://autospace:autospace-local-password@localhost:5432/autospace?schema=public"
DATABASE_LOGGING=false
DATABASE_POOL_MAX=20
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_DEFAULT_TOPIC=platform.events.v1
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_MS=5000
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP=autospace-api-consumer
KAFKA_CONSUMER_TOPICS=platform.events.v1
AVAILABILITY_GRPC_ADDRESS=availability-service:9091
S3_ENDPOINT=http://localhost:9000

JWT_SECRET=

STRIPE_SECRET_KEY=

STRIPE_SUCCESS_URL=http://localhost:3000/stripe/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3001/booking-failed

BOOKINGS_REDIRECT_URL=http://localhost:3001/bookings
